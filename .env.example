# Copy this file to .env (repo root) and fill in real values before running docker compose.
# .env is gitignored and never committed. These values are injected into containers by
# docker-compose.yaml's ${VAR} interpolation — not by any service's own env_file.

DB_NAME=fragrance
DB_USER=fragrance
DB_PASSWORD=your_db_password

SEARXNG_SECRET=your_searxng_secret

REDIS_PASSWORD=your_redis_password

# Search API keys used by SearXNG's engine config (searxng/settings.yml)
BRAVE_API_KEY=your_brave_api_key

# Django admin path — single source of truth, threaded into backend/celery-worker/celery-beat's
# DJANGO_ADMIN_URL and into nginx's templated admin location (nginx/nginx.conf.template) so the
# two can never drift apart. Do NOT use "admin" or anything guessable — generate with:
#   openssl rand -hex 8
# Must be lowercase alphanumeric/hyphens, at least 8 characters (see backend/config/settings.py's
# validation). Only used in production (nginx/nginx.conf.template); local dev uses a fixed
# "dev-admin" literal instead (see docker-compose.override.yaml / nginx/nginx.dev.conf).
ADMIN_URL_PATH=change-me-to-a-random-path
