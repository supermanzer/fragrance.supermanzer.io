# ── Docker ────────────────────────────────────────────────────────────────────
# Don't ignore docker-compose.yaml — it's checked in
# Ignore override files that hold local secrets or port tweaks
docker-compose.override.yaml
docker-compose.override.yml

# ── Certbot / Let's Encrypt ───────────────────────────────────────────────────
# certbot/ directory holds live TLS certs — never commit
certbot/

# ── SearXNG ───────────────────────────────────────────────────────────────────
# settings.yml may contain API keys or tokens
searxng/settings.yml

# ── Nginx ─────────────────────────────────────────────────────────────────────
# nginx.conf.template is checked in; the rendered nginx.conf only ever exists inside the
# container filesystem. Ignore generated dhparam files.
nginx/dhparam.pem

# Real IP allowlist entries for the admin path — only the *.example reference file is tracked;
# an operator's actual allowed IPs never enter git. Ignores everything in the directory by
# default (not just *.conf) so a misnamed real file — wrong extension, no extension, a .bak —
# can't slip past the ignore rule and get committed by accident (confirmed live: the narrower
# *.conf-only rule missed exactly this case).
nginx/admin_allowlist.d/*
!nginx/admin_allowlist.d/*.example

