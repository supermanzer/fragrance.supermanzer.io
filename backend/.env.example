# Copy this file to backend/.env and fill in values before running the app.
# backend/.env is gitignored and never committed.
#
# Root-level secrets (REDIS_PASSWORD, SEARXNG_SECRET, PUBLIC_API_BASE) live in
# the root .env file and are injected into these containers by docker-compose.

# Django
DJANGO_SECRET_KEY=your_django_key               # generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DEBUG=True                          # set to False in production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Django admin — DO NOT set this to "admin" or anything guessable. Must be
# lowercase alphanumeric/hyphens, 8+ characters. Generate with:
#   openssl rand -hex 8
# In Docker Compose (dev and prod), this value is actually supplied by the
# `environment:` block on the backend/celery-worker/celery-beat services
# (coordinator-owned, in docker-compose.yaml / docker-compose.override.yaml),
# derived from a single root-.env value — what you set here only matters if
# you run manage.py directly outside those environments.
# If you test the admin panel through nginx locally (nginx.dev.conf), this
# value must match whatever literal path is hardcoded there — nginx and
# Django resolving different paths will silently break local admin routing.
DJANGO_ADMIN_URL=change-me-to-a-random-path

# Database
DB_PASSWORD=your_db_password
DB_HOST=db                          # use 'localhost' when running Django outside Docker

# Redis — REDIS_PASSWORD is injected by docker-compose from root .env.
# REDIS_HOST defaults to 'redis'; override for non-Docker local dev if needed.
# REDIS_HOST=localhost
# CELERY_BROKER_URL can override the auto-constructed URL entirely if needed.

# LLM providers — only the key for the family selected via the active
# AIModelConfig row needs a real value; the others can stay as placeholders.
ANTHROPIC_API_KEY=your_anthropic_key
OPENAI_API_KEY=your_openai_key
DASHSCOPE_API_KEY=your_dashscope_key                # Qwen, via Alibaba Cloud Model Studio's OpenAI-compatible endpoint
# DASHSCOPE_BASE_URL defaults to the international endpoint (dashscope-intl...).
# Only set this if your DashScope account/key is China-region — the two use
# non-interchangeable API keys, so the wrong one silently 401s.
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Email — sent via Postmark REST API (no SMTP ports needed)
# Create a Server API Token at: account.postmarkapp.com → Servers → your server → API Tokens
# The From address must be a verified Sender Signature in your Postmark account.
POSTMARK_SERVER_TOKEN=your_postmark_server_token
DEFAULT_FROM_EMAIL=noreply@supermanzer.io       # optional; defaults to noreply@supermanzer.io

# CORS — required; no default, startup fails if unset
CORS_ALLOWED_ORIGINS=http://localhost:3000
